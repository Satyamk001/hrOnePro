{
  "manifest_version": 3,
  "name": "Attendance Interceptor",
  "version": "2.7.0",
  "description": "Auto-syncs HROne attendance data to the Attendance Insights dashboard",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://app.hrone.cloud/*",
    "https://*.hrone.cloud/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.hrone.cloud/*", "https://*.hrone.cloud/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://app.hrone.cloud/*", "https://*.hrone.cloud/*"],
      "js": ["receiver.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageWorld.js"],
      "matches": ["https://app.hrone.cloud/*", "https://*.hrone.cloud/*"]
    }
  ]
}
